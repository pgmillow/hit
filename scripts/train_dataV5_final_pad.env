# ==============================================================
# pi05 V5 final 微调 (letterbox padding 版本)
# repo_id: local/openpi_V5_mcap0625_v3src_pad
# 数据来源: 已经带黑边 padding 的 v3.0 格式数据集 (lerobot_mcap0625_v3,
# 272 episode/42.3万帧)，经 scripts/../data/convert_lerobot_v3_to_v2.py
# 转换为本项目可用的 v2.1 格式。
# 对应 config.py → dataV5_final_v3src_pad (与 dataV5_final 超参完全一致，
# 唯一区别是数据集图像预处理从"拉伸"改为"等比缩放+黑边填充"，
# 与部署端 preprocess_to_vla_shape / openpi_client.resize_with_pad 保持一致)
#
# 用法:
#   bash scripts/train_dataV5_final_pad.sh
#   bash scripts/train_dataV5_final_pad.sh NUM_TRAIN_STEPS=500 EXP_NAME=smoke
# ==============================================================

# ---------- 硬件 / 运行环境 ----------
# dataV5_final (拉伸版) 正在 GPU0/1 上训练，这里用 GPU2/3 跑 padding 版做对比
GPUS=2,3
NCCL_P2P_DISABLE=1
XLA_MEM_FRACTION=0.9
JAX_CACHE_DIR=/home/xudi_ge/.cache/jax

# ---------- 路径 ----------
HF_LEROBOT_HOME=/home/xudi_ge/data/lerobot_openpi
PYTHON_BIN=/home/xudi_ge/openpi/.venv/bin/python
TRAIN_SCRIPT=/home/xudi_ge/openpi/scripts/train.py
ASSETS_BASE_DIR=/home/xudi_ge/openpi/assets
CHECKPOINT_BASE_DIR=/data/gxdcheckpoint
# 完整 checkpoint 目录: ${CHECKPOINT_BASE_DIR}/${CONFIG_NAME}/${EXP_NAME}
CHECKPOINT_DIR=/data/gxdcheckpoint/dataV5_final_v3src_pad/dataV5_final_v3src_pad

# ---------- 训练超参 (与 config.py dataV5_final_v3src_pad 一致) ----------
CONFIG_NAME=dataV5_final_v3src_pad
EXP_NAME=dataV5_final_v3src_pad
BATCH_SIZE=32
GRAD_ACCUM_STEPS=1
FSDP_DEVICES=2
# v3src_pad: 423423 frames (272 episodes), batch 32 → ~13232 step/epoch
# 60k steps ≈ 4.5 epochs
EPOCHS=6
TOTAL_FRAMES=423423
NUM_TRAIN_STEPS=60000
LOG_INTERVAL=50
SAVE_INTERVAL=2000
KEEP_PERIOD=4000
EMA_DECAY=None

# ---------- 开关 ----------
OVERWRITE=true
RESUME=false
WANDB=false
TENSORBOARD=true
# 只开亮度/对比度/饱和度/色调轻微抖动(p=0.1)，不开裁剪/旋转；具体幅度在 config.py
# 的 dataV5_final_v3src_pad -> model.image_aug_* 里设置。这里必须是 true，
# 否则会通过 --no-train-image-augment 覆盖掉 config.py 里的 train_image_augment=True。
train_image_augment=true
