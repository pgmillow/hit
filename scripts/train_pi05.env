# ==============================================================
# pi05 双卡微调配置文件 (config)
# 只改这里的值即可调参；启动逻辑在 train_pi05.sh，互不干扰。
# 用法: bash scripts/train_pi05.sh
# 临时覆盖: bash scripts/train_pi05.sh EXP_NAME=test NUM_TRAIN_STEPS=20
# ==============================================================

# ---------- 硬件 / 运行环境 ----------
GPUS=0,1                       # 只用 0,1 两张卡
NCCL_P2P_DISABLE=1             # 必须！本机 NCCL P2P 有问题，不加会卡死
XLA_MEM_FRACTION=0.9           # 每卡预分配显存比例
JAX_CACHE_DIR=/home/xudi_ge/.cache/jax   # JIT 编译缓存，加速重复启动

# ---------- 路径 ----------
HF_LEROBOT_HOME=/home/xudi_ge/data/lerobot_openpi
PYTHON_BIN=/home/xudi_ge/openpi/.venv/bin/python
TRAIN_SCRIPT=/home/xudi_ge/openpi/scripts/train.py
ASSETS_BASE_DIR=/home/xudi_ge/openpi/assets
CHECKPOINT_BASE_DIR=/data/gxdcheckpoint

# ---------- 训练超参 ----------
CONFIG_NAME=gxd_pi05_stateconti # 标准 pi05: 离散 state token，从 4000 checkpoint 初始化
EXP_NAME=gxd_pi05_standard_state_from4000_3epoch
BATCH_SIZE=32                  # 全局 batch；必须能被 FSDP_DEVICES 整除
GRAD_ACCUM_STEPS=1             # 梯度累计步数 (1=关闭)
FSDP_DEVICES=2                 # FSDP 分片卡数
# --- 用 epoch 设置训练时长，启动器自动换算成 step ---
# 换算: 有效batch = BATCH_SIZE * GRAD_ACCUM_STEPS
#       每epoch步数 = ceil(TOTAL_FRAMES / 有效batch)
#       总步数 = EPOCHS * 每epoch步数
EPOCHS=3                       # 训练轮数
TOTAL_FRAMES=533373            # 数据集总帧数 (meta/info.json 的 total_frames)
NUM_TRAIN_STEPS=               # 留空=按 EPOCHS 自动算; 填数字=直接用该值(覆盖 EPOCHS)
LOG_INTERVAL=10               # 每多少步记一次 loss
SAVE_INTERVAL=1000             # 每多少步存一次 checkpoint
KEEP_PERIOD=10000            # 里程碑保留间隔；设很大=只滚动保留最新一个(省盘)
EMA_DECAY=None                 # EMA 衰减；None=关闭

# ---------- 开关 ----------
OVERWRITE=true                 # true=覆盖同名实验目录
RESUME=false                   # true=从已有 checkpoint 续训(与 OVERWRITE 互斥)
WANDB=false                     # true=启用 wandb
TENSORBOARD=true               # true=启用 tensorboard
train_image_augment=false      # false=关闭模型侧图像增强，优先保证数值稳定
