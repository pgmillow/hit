# ==============================================================
# pi05 V5 final v2: eps=1e-6 + freeze vision encoder + schedule_offset=1
# 对应 config.py → dataV5_final_v3src_pad_v2
# ==============================================================

# ---------- 硬件 / 运行环境 ----------
GPUS=2,3
NCCL_P2P_DISABLE=1
XLA_MEM_FRACTION=0.9
JAX_CACHE_DIR=/home/xudi_ge/.cache/jax

# ---------- 路径 ----------
HF_LEROBOT_HOME=/home/xudi_ge/data/lerobot_openpi
PYTHON_BIN=/home/xudi_ge/openpi/.venv/bin/python
TRAIN_SCRIPT=/home/xudi_ge/openpi/scripts/train.py
ASSETS_BASE_DIR=/home/xudi_ge/openpi/assets
CHECKPOINT_BASE_DIR=/data/gxdcheckpoint

# ---------- 训练超参 ----------
CONFIG_NAME=dataV5_final_v3src_pad_v2
EXP_NAME=dataV5_final_v3src_pad_v2
BATCH_SIZE=32
GRAD_ACCUM_STEPS=1
FSDP_DEVICES=2
EPOCHS=5
TOTAL_FRAMES=423423
NUM_TRAIN_STEPS=60000
LOG_INTERVAL=50
SAVE_INTERVAL=2000
KEEP_PERIOD=4000
EMA_DECAY=None

# ---------- 开关 ----------
OVERWRITE=true
RESUME=false
WANDB=false
TENSORBOARD=true
train_image_augment=true
