# ==============================================================
# pi05 V5 final 续训 (letterbox padding 版本, 从 step 12000 继续)
# repo_id: local/openpi_V5_mcap0625_v3src_pad
# 对应 config.py → dataV5_final_v3src_pad_conti
#
# 从原 run 的 12000 步 checkpoint 加载权重，LR schedule 偏置 12001 步
# (local step 0 的学习率 = 原 schedule 在 step 12001 的值 ≈ 8.14e-6)。
# 再训 48000 步，global step 12000 → 60000。
#
# Checkpoint 输出 (新目录，不覆盖原 run):
#   /data/gxdcheckpoint/dataV5_final_v3src_pad_conti/dataV5_final_v3src_pad_conti/
#
# 用法:
#   bash scripts/train_dataV5_final_pad_conti.sh
#   bash scripts/train_dataV5_final_pad_conti.sh NUM_TRAIN_STEPS=1000 EXP_NAME=smoke
# ==============================================================

# ---------- 硬件 / 运行环境 ----------
GPUS=2,3
NCCL_P2P_DISABLE=1
XLA_MEM_FRACTION=0.9
JAX_CACHE_DIR=/home/xudi_ge/.cache/jax

# ---------- 路径 ----------
HF_LEROBOT_HOME=/home/xudi_ge/data/lerobot_openpi
PYTHON_BIN=/home/xudi_ge/openpi/.venv/bin/python
TRAIN_SCRIPT=/home/xudi_ge/openpi/scripts/train.py
ASSETS_BASE_DIR=/home/xudi_ge/openpi/assets
CHECKPOINT_BASE_DIR=/data/gxdcheckpoint
# 源 checkpoint (只读，用于加载 12000 步权重)
SOURCE_CHECKPOINT_DIR=/data/gxdcheckpoint/dataV5_final_v3src_pad/dataV5_final_v3src_pad/12000/params
# 新 run 输出目录: ${CHECKPOINT_BASE_DIR}/${CONFIG_NAME}/${EXP_NAME}
CHECKPOINT_DIR=/data/gxdcheckpoint/dataV5_final_v3src_pad_conti/dataV5_final_v3src_pad_conti

# ---------- 训练超参 (与 config.py dataV5_final_v3src_pad_conti 一致) ----------
CONFIG_NAME=dataV5_final_v3src_pad_conti
EXP_NAME=dataV5_final_v3src_pad_conti
BATCH_SIZE=32
GRAD_ACCUM_STEPS=1
FSDP_DEVICES=2
# v3src_pad: 423423 frames, batch 32 → ~13232 step/epoch; 48000 steps ≈ 3.6 epoch
EPOCHS=4
# Warm restart: train_state.step 恢复到 12000，循环从 12000 跑到 60000 (48000 步)
RESUME_FROM_STEP=12000
NUM_TRAIN_STEPS=60000
# log_step_offset=0: warm restart 后 step 已是全局值 (12000→60000)
LOG_STEP_OFFSET=0
TOTAL_FRAMES=423423
LOG_INTERVAL=50
SAVE_INTERVAL=3000
KEEP_PERIOD=6000
EMA_DECAY=None

# ---------- 开关 ----------
OVERWRITE=false
RESUME=true
WANDB=false
TENSORBOARD=true
train_image_augment=true
