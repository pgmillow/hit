# ==============================================================
# pi05 双臂倒水微调 (double_V1, bimanual)
# repo_id: local/double_V1
# 数据:
#   源: /data/double_V1 (LeRobot v3, 60Hz, 143 ep / 312683 frames)
#   OpenPI 格式: /data/double_V1_openpi
#   软链: ${HF_LEROBOT_HOME}/local/double_V1 -> /data/double_V1_openpi
# 对应 config.py → pi05_double_V1
#   - bimanual=True（左右臂 14 维全训）
#   - 全参微调, cosine 5e-5 → 5e-7, 8 epochs
#
# 用法:
#   bash scripts/train_double_V1.sh
#   bash scripts/train_double_V1.sh NUM_TRAIN_STEPS=500 EXP_NAME=smoke
#   bash scripts/train_double_V1.sh XLA_MEM_FRACTION=0.95
# ==============================================================

# ---------- 硬件 / 运行环境 ----------
GPUS=0,1,2,3
NCCL_P2P_DISABLE=1
# JAX 默认只有 0.75；全参+batch64 建议 0.9~0.95，否则易 OOM
XLA_MEM_FRACTION=0.95
JAX_CACHE_DIR=/home/xudi_ge/.cache/jax

# ---------- 路径 ----------
HF_LEROBOT_HOME=/home/xudi_ge/.cache/huggingface/lerobot
PYTHON_BIN=/home/xudi_ge/openpi/.venv/bin/python
TRAIN_SCRIPT=/home/xudi_ge/openpi/scripts/train.py
ASSETS_BASE_DIR=/home/xudi_ge/openpi/assets
CHECKPOINT_BASE_DIR=/data/final_double_hands_openpi
# 完整 checkpoint 目录: ${CHECKPOINT_BASE_DIR}/${CONFIG_NAME}/${EXP_NAME}
CHECKPOINT_DIR=/data/final_double_hands_openpi/pi05_double_V1/pi05_double_V1

# ---------- 训练超参 (与 config.py pi05_double_V1 对齐) ----------
CONFIG_NAME=pi05_double_V1
EXP_NAME=pi05_double_V1
BATCH_SIZE=64
GRAD_ACCUM_STEPS=1
FSDP_DEVICES=4
NUM_WORKERS=8
# double_V1: 312683 frames (143 episodes), batch 64 → 4886 step/epoch
# 8 epochs → 39088 steps
EPOCHS=8
TOTAL_FRAMES=312683
NUM_TRAIN_STEPS=39088
LOG_INTERVAL=50
SAVE_INTERVAL=4886
KEEP_PERIOD=4886
EMA_DECAY=None

# ---------- 开关 ----------
OVERWRITE=true
RESUME=false
WANDB=false
TENSORBOARD=true
# 只开轻度 ColorJitter；幅度在 config.py pi05_double_V1 -> model.image_aug_*
train_image_augment=true
