# ==============================================================
# pi05 V5 conti linear — 从 12000 步 checkpoint 只加载权重，
# 线性 LR 9e-6 → 5e-7，optimizer state 重置，全新开始训练。
# 对应 config.py → dataV5_final_v3src_pad_linear
#
# Checkpoint 输出:
#   /data/gxdcheckpoint/dataV5_final_v3src_pad_linear/V5_conti_linear/
#
# 用法:
#   bash scripts/train_V5_conti_linear.sh
#   bash scripts/train_V5_conti_linear.sh NUM_TRAIN_STEPS=500 EXP_NAME=smoke
# ==============================================================

# ---------- 硬件 / 运行环境 ----------
GPUS=2,3
NCCL_P2P_DISABLE=1
XLA_MEM_FRACTION=0.9
JAX_CACHE_DIR=/home/xudi_ge/.cache/jax

# ---------- 路径 ----------
HF_LEROBOT_HOME=/home/xudi_ge/data/lerobot_openpi
PYTHON_BIN=/home/xudi_ge/openpi/.venv/bin/python
TRAIN_SCRIPT=/home/xudi_ge/openpi/scripts/train.py
ASSETS_BASE_DIR=/home/xudi_ge/openpi/assets
CHECKPOINT_BASE_DIR=/data/gxdcheckpoint
# 完整 checkpoint 目录: ${CHECKPOINT_BASE_DIR}/${CONFIG_NAME}/${EXP_NAME}
CHECKPOINT_DIR=/data/gxdcheckpoint/dataV5_final_v3src_pad_linear/V5_conti_linear

# ---------- 训练超参 (与 config.py dataV5_final_v3src_pad_linear 一致) ----------
CONFIG_NAME=dataV5_final_v3src_pad_linear
EXP_NAME=V5_conti_linear
BATCH_SIZE=32
GRAD_ACCUM_STEPS=1
FSDP_DEVICES=2
# v3src_pad: 423423 frames, batch 32 → ~13232 step/epoch; 60k steps ≈ 4.5 epochs
EPOCHS=6
TOTAL_FRAMES=423423
NUM_TRAIN_STEPS=40000
LOG_INTERVAL=50
SAVE_INTERVAL=3000
KEEP_PERIOD=6000
EMA_DECAY=None

# ---------- 开关 ----------
OVERWRITE=true
RESUME=false
WANDB=false
TENSORBOARD=true
train_image_augment=true
